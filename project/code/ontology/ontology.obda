[PrefixDeclaration]
:		http://rolandb.com/ontologies/dc#
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
xml:		http://www.w3.org/XML/1998/namespace
xsd:		http://www.w3.org/2001/XMLSchema#
rdfs:		http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[
mappingId	MAP-DISTRICT
target		:district/{code} a :District ; :districtCode {code}^^xsd:integer ; :districtNameIt {name_it}^^xsd:string ; :districtNameDe {name_de}^^xsd:string . 
source		SELECT code, name_it, name_de FROM District

mappingId	MAP-MUNICIPALITY
target		:municipality/{istat_code} a :Municipality ; :istatCode {istat_code}^^xsd:integer ; :zipCode {zip_code}^^xsd:integer ; :nameIt {name_it}^^xsd:string ; :nameDe {name_de}^^xsd:string ; :nameLd {name_ld}^^xsd:string ; :area {area}^^xsd:float ; :geometry {geom}^^xsd:string . 
source		SELECT istat_code, zip_code, name_it, name_de, name_ld, area, ST_AsText(geom) as geom from Municipality

mappingId	MAP-INFRASTRUCTURE-LINE
target		:infrastructure/{code} a :InfrastructureLine ; :infrastructureIn :municipality/{istat_code} ; :infrastructureCode {code}^^xsd:integer ; :lineLength {shape_len}^^xsd:float ; :geometry {geom}^^xsd:string . 
source		SELECT code, istat_code, shape_len, ST_AsText(geom) as geom FROM InfrastructureLine

mappingId	MAP-INFRASTRUCTURE-LINE-TYPE
target		:infrastructure/{code} :typeNameIt {name_it}^^xsd:string ; :typeNameDe {name_de}^^xsd:string . 
source		SELECT InfrastructureLine.code, name_it, name_de FROM InfrastructureLine, InfrastructureType WHERE type_code = InfrastructureType.code

mappingId	MAP-INFRASTRUCTURE-NODE
target		:infrastructure/{code} a :InfrastructureNode ; :infrastructureIn :municipality/{istat_code} ; :infrastructureCode {code}^^xsd:integer ; :geometry {geom}^^xsd:string . 
source		SELECT code, istat_code, ST_AsText(geom) as geom FROM InfrastructureNode

mappingId	MAP-INFRASTRUCTURE-NODE-TYPE
target		:infrastructure/{code} :typeNameIt {name_it}^^xsd:string ; :typeNameDe {name_de}^^xsd:string . 
source		SELECT InfrastructureNode.code, name_it, name_de FROM InfrastructureNode, InfrastructureType WHERE type_code = InfrastructureType.code

mappingId	MAP-INFRASTRUCTURE-LINE-ENERGY
target		:infrastructure/{code} a :EnergyInfrastructure . 
source		SELECT InfrastructureLine.code FROM InfrastructureLine, InfrastructureType WHERE type_code = InfrastructureType.code AND name_de IN ('Methangasleitung', 'Hochspannungsleitung', 'Mittelspannungsleitung', 'Fernwärmeleitung', 'Methangasleitung - Bannstreifen', 'Hochspannungsleitung - Bannstreifen')

mappingId	MAP-INFRASTRUCTURE-LINE-WATER
target		:infrastructure/{code} a :WaterInfrastructure . 
source		SELECT InfrastructureLine.code FROM InfrastructureLine, InfrastructureType WHERE type_code = InfrastructureType.code AND name_de IN ('Trinkwasserleitung', 'Druckrohrleitung')

mappingId	MAP-INFRASTRUCTURE-LINE-WASTE
target		:infrastructure/{code} a :WasteInfrastructure . 
source		SELECT InfrastructureLine.code FROM InfrastructureLine, InfrastructureType WHERE type_code = InfrastructureType.code AND name_de IN ('Abwasserleitung', 'Schlammleitung')

mappingId	MAP-INFRASTRUCTURE-NODE-COMMUNICATION
target		:infrastructure/{code} a :CommunicationInfrastructure . 
source		SELECT InfrastructureNode.code FROM InfrastructureNode, InfrastructureType WHERE type_code = InfrastructureType.code AND name_de IN ('Kommunikationsinfrastruktur')

mappingId	MAP-INFRASTRUCTURE-NODE-ENERGY
target		:infrastructure/{code} a :EnergyInfrastructure . 
source		SELECT InfrastructureNode.code FROM InfrastructureNode, InfrastructureType WHERE type_code = InfrastructureType.code AND name_de IN ('E-Werk', 'Umspannstation', 'Fernheizanlage')

mappingId	MAP-INFRASTRUCTURE-NODE-WATER
target		:infrastructure/{code} a :WaterInfrastructure . 
source		SELECT InfrastructureNode.code FROM InfrastructureNode, InfrastructureType WHERE type_code = InfrastructureType.code AND name_de IN ('Wasserfassung', 'Reservoir', 'Pumpstation')

mappingId	MAP-INFRASTRUCTURE-NODE-WASTE
target		:infrastructure/{code} a :WasteInfrastructure . 
source		SELECT InfrastructureNode.code FROM InfrastructureNode, InfrastructureType WHERE type_code = InfrastructureType.code AND name_de IN ('Kläranlage', 'Müllentsorgungsanlage', 'Recyclinganlage')
]]

